# Copy this file to backend/.env and edit values for the deployment.
FLORAGUARD_DATABASE_PATH=backend/data/floraguard.db
FLORAGUARD_UPLOAD_DIR=backend/data/uploads
FLORAGUARD_AREAS=Gishari Flower Park
# Optional mapping for area-only channels. Do not configure guessed coordinates.
# Format: Area Name:latitude,longitude;Another Area:latitude,longitude
FLORAGUARD_AREA_COORDINATES=
FLORAGUARD_USSD_CODE=*XXX#
FLORAGUARD_CONFIDENCE_THRESHOLD=0.60
FLORAGUARD_RISK_WINDOW_DAYS=7
FLORAGUARD_RISK_RADIUS_KM=5
FLORAGUARD_RISK_MEDIUM_THRESHOLD=30
FLORAGUARD_RISK_HIGH_THRESHOLD=65
FLORAGUARD_MAX_IMAGE_SIZE_MB=10
FLORAGUARD_WEATHER_TIMEOUT_SECONDS=4
# After installing root AI dependencies and activating a trained model, set:
# FLORAGUARD_PREDICTOR=predictor:predict_image
FLORAGUARD_PREDICTOR=
# Optional, relative to the project root or an absolute model path:
# FLORAGUARD_MODEL_PATH=models/floraguard_v1.keras
# Comma-separated browser origins. Keep localhost entries for local development.
FLORAGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
